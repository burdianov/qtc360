# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qtc360
POSTGRES_USER=qtc360
POSTGRES_PASSWORD=qtc360_dev

# Backend
BACKEND_PORT=8000

# Auth — REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# In production the server refuses to start if this is the placeholder below.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment ("development" or "production"). Production hides /docs and turns on HSTS.
ENVIRONMENT=development

# Comma-separated CORS origins (no spaces required).
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@qtc360.local
PGADMIN_DEFAULT_PASSWORD=admin

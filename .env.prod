# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=qtc360
POSTGRES_USER=qtc360
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Auth
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_-c_import_secrets_print_secrets.token_urlsafe_64
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=production
ALLOWED_ORIGINS=https://qtc360.com

# File Storage
UPLOAD_DIR=/app/uploads

# Gotenberg (internal Docker network)
GOTENBERG_URL=http://gotenberg:3000

# Frontend API URL (used at build time in docker-compose.prod.yml)
NEXT_PUBLIC_API_URL=https://api.qtc360.com/api/v1
